;; pico.ctx.layer(l): a context that keeps `l` current for the code bound to
;; it. Tasks of a HUD (a pool of 10) and of a minimap draw each frame into
;; their layers, while another task draws into the world.
`setenv("PICO_ATM_FRAMES", "20:20", 0);`

pico.open [ title="Ctx Layer" ]
val world = pico.layer.world
pin hud = pico.layer.empty [ up=world, clear=true, dim=['!',w=100,h=10],
    target=['!', x=0, y=0, w=100, h=10, anchor=:NW] ]
pin map = pico.layer.empty [ up=world, clear=true, dim=['!',w=20,h=20],
    target=['!', x=80, y=80, w=20, h=20, anchor=:NW] ]

var n = 0
var sw = 0                              ;; switches of the current layer
val ctx = pico.ctx.layer
val count = \(c) {                      ;; the context `c`, counting
    :Context [
        enter = \{ set sw = sw + 1 ; c.enter() },
        leave = \(o) { set sw = sw + 1 ; c.leave(o) },
    ]
}

task Bar (i) {
    loop on :draw {
        assert(pico.get.layer() == hud)
        pico.output.draw.rect ['!', x=(n+i*10)%100, y=2, w=3, h=3, anchor=:NW]
    }
}

par :any {
    loop on :frame {
        set n = n + 1
    }
} with {
    loop on :draw {
        assert(pico.get.layer() == world)
        pico.output.draw.rect ['!', x=n%100, y=50, w=5, h=5]
    }
} with {
    ;; the pool is bound: every task spawned into it lives in the context
    pin ts = in count(ctx(hud)), tasks()
    loop i in 10 {
        spawn @ts Bar(i)
    }
    await :never
} with {
    in ctx(map), do {
        loop on :draw {
            assert(pico.get.layer() == map)
            pico.output.draw.pixel ['!', x=n%20, y=10]
        }
    }
} with {
    await :quit
}

;; the lazy switch: per frame, one enter and one leave around the whole pool
;; (2*n), not a pair per task (2*10*n by hand); the rest is the start (a pair
;; per spawn into the pool) and the end (a pair per task aborted)
assert(sw <= 2*n + 4*10 + 4)
assert(pico.get.layer() == world)

;; the picture of the last frame, against its reference
pico.check("ctx-layer-01")
