;; Lifetime of layers, fonts, and sounds.

val OUT = "../c/tst/out/"

func bytes (path) {
    pin f = io.open(path, "rb")
    assert(f, "cannot open " ++ path)
    val c = io.read(f, :all)
    io.close(f)
    c
}

;; the window, as it is presented, as a string of bytes
func shot (name) {
    pico.output.present()
    bytes(pico.output.screenshot(pico.layer.window, OUT ++ "life-" ++ name ++ ".png"))
}

;; the call must fail with a message that contains `msg`
func fails (msg, f) {
    val ok, err = catch true { f() }
    assert(!ok, "expected error : " ++ msg)
    assert(string.find(err, msg), "unexpected error : " ++ err)
    print("error", err)
}

;; the world redrawn from nothing but its children
func redraw (name) {
    pico.output.clear()
    shot(name)
}

func fill (l, clr) {
    val old = pico.set.layer(l)
    pico.set.effect [ color=clr ]
    pico.output.clear()
    pico.set.layer(old)
}

val RED  = ['!', x=0, y=0, w=10, h=10, anchor='NW']
val HALF = ['%', x=0.5, y=0.5, w=0.5, h=0.5]

;; errors before pico.open
fails("pico is not open", \{ pico.output.clear() })
assert(pico.layer.world==nil && pico.layer.window==nil)    ;; values, not yet set
fails("pico is not open", \{ pico.close() })

;; the first open, with the defaults
pico.open()
assert(pico.get.app().title == "pico-SDL")
fails("pico is already open", \{ pico.open() })
val first = pico.layer.world
assert(type(first)=='native' && type(pico.layer.window)=='native')
assert(first==pico.layer.world && first!=pico.layer.window)
assert(pico.get.layer() == pico.layer.world)
;; the roots belong to the binding: a program cannot pin them
fails("unexpected pinned value", \{ pin w = pico.layer.world })

;; errors while pico is closed
pico.close()
fails("pico is not open", \{ pico.output.clear() })
assert(pico.layer.world==nil && pico.layer.window==nil)    ;; reset by the close
fails("pico is not open", \{ pico.close() })

;; open again: only after a close
pico.open()
var world = pico.layer.world
assert(world!=nil && world!=first)    ;; new values at each open
fails("pico is already open", \{ pico.open() })
fails("invalid layer", \{ pico.set.layer(first) })
pico.output.clear()
val empty = shot("empty")

print("1. parent dropped before its child")
do {
    var parent = pico.layer.empty [ up=world, dim=['!',w=20,h=20], target=HALF ]
    pin child  = pico.layer.empty [ up=parent, dim=['!',w=4,h=4], target=HALF ]
    fill(parent, 'blue')
    fill(child, 'red')
    val both = redraw("1-both")
    assert(both != empty)
    set parent = nil                ;; still alive: the child depends on it
    assert(redraw("1-drop") == both)
    fill(child, 'red')              ;; the child is still usable
    assert(redraw("1-fill") == both)
}                                   ;; the child goes, then the parent
assert(redraw("1-none") == empty)

print("2. a child belongs to the block of its parent")
do {
    pin out = []
    var both
    do {
        pin parent = pico.layer.empty [ up=world, dim=['!',w=20,h=20], target=HALF ]
        ;; the table of arguments holds a pinned value, with no pin
        pin child = pico.layer.empty [ up=parent, dim=['!',w=4,h=4], target=HALF ]
        fill(parent, 'blue')
        fill(child, 'red')
        set both = redraw("2-both")
        assert(both != empty)
        ;; a child cannot leave the block of its parent
        fails("invalid escape : native pinned at", \{
            set out.child = pico.layer.empty [ up=parent, dim=['!',w=4,h=4] ]
        })
        assert(redraw("2-fail") == both)
    }                               ;; the child goes, then the parent
    assert(redraw("2-none") == empty)
    do {
        ;; the table is pinned before the parent of what it holds: the
        ;; parent is finalized first, and postponed until the child goes
        pin ts = []
        pin parent = pico.layer.empty [ up=world, dim=['!',w=20,h=20], target=HALF ]
        set ts.child = pico.layer.empty [ up=parent, dim=['!',w=4,h=4], target=HALF ]
        fill(parent, 'blue')
        fill(ts.child, 'red')
        assert(redraw("2-order") == both)
    }
    assert(redraw("2-gone") == empty)
}

print("3. current layer dropped")
do {
    ;; never pinned: it is only alive as the current layer
    pico.set.layer(pico.layer.empty [ dim=['!',w=8,h=8] ])
    assert(pico.get.layer() != nil)
    assert(pico.get.layer() != world)
    fails("onto itself", \{ pico.output.draw.layer(pico.get.layer()) })
    pico.output.clear()
    pico.output.draw.rect(RED)
    assert(pico.get.scene().dim.w == 8)
    ;; the previous layer comes back fresh: a `val` holds it (pin rules of
    ;; 2026-11-17), and it is released with the name
    val old = pico.set.layer(world)
    assert(old != nil)
    assert(pico.get.layer() == world)
}

print("4. current layer pinned in a block that ends")
do {
    do {
        pin l = pico.layer.empty [ dim=['!',w=8,h=8] ]
        val old = pico.set.layer(l)
        assert(old == world)
        assert(pico.get.layer() == l)
        assert(pico.get.scene().dim.w == 8)
    }                               ;; released: the world is current again
    assert(pico.get.layer() == world)
    assert(pico.get.scene().dim.w == 100)
    pico.output.clear()
    pico.output.draw.rect(RED)      ;; on the world
    val red = shot("4-world")
    assert(red != empty)
    assert(pico.set.layer(world) == world)
    assert(redraw("4-clear") == empty)

    ;; the current layer is a child, in the block of its parent: the
    ;; child goes first, then the parent
    do {
        pin parent = pico.layer.empty [ up=world, dim=['!',w=20,h=20], target=HALF ]
        pin child  = pico.layer.empty [ up=parent, dim=['!',w=4,h=4], target=HALF ]
        pico.set.layer(child)
    }
    assert(pico.get.layer() == world)
    assert(redraw("4-child") == empty)

    ;; the current layer is a parent, finalized while its child is alive
    ;; (the table is pinned before it): it waits for the child
    do {
        pin ts = []
        pin parent = pico.layer.empty [ up=world, dim=['!',w=20,h=20], target=HALF ]
        set ts.child = pico.layer.empty [ up=parent, dim=['!',w=4,h=4], target=HALF ]
        pico.set.layer(parent)
    }
    assert(pico.get.layer() == world)
    assert(redraw("4-parent") == empty)

    ;; the current layer leaves its table: the binding still refers to it,
    ;; as a name, until the end of the block of the table
    do {
        pin ts = [ l = pico.layer.empty [ dim=['!',w=8,h=8] ] ]
        pico.set.layer(ts.l)
        set ts.l = nil
        assert(pico.get.layer() != world)
        assert(pico.get.scene().dim.w == 8)
    }
    assert(pico.get.layer() == world)
    assert(pico.get.scene().dim.w == 100)

    ;; the previous layer that `pico.set.layer` gives back is the world
    do {
        pin l = pico.layer.empty [ dim=['!',w=8,h=8] ]
        pico.set.layer(l)
    }
    pin l2 = pico.layer.empty [ dim=['!',w=8,h=8] ]
    assert(pico.set.layer(l2) == world)
    assert(pico.set.layer(world) == l2)
}

print("5. source of a sub-layer dropped")
do {
    pin t = [ src = pico.layer.empty [ dim=['!',w=8,h=8] ] ]
    fill(t.src, 'green')
    pin sub = pico.layer.sub [ sup=t.src, crop=['!',x=0,y=0,w=4,h=4,anchor='NW'] ]
    fails("sub-layer of a sub-layer", \{
        pico.layer.sub [ sup=sub, crop=['!',x=0,y=0,w=2,h=2,anchor='NW'] ]
    })
    pico.output.clear()
    pico.output.draw.layer(sub, HALF)
    val drawn = shot("5-with")
    assert(drawn != empty)
    set t.src = nil                 ;; still alive: the sub-layer depends on it
    pico.output.clear()
    pico.output.draw.layer(sub, HALF)
    assert(shot("5-drop") == drawn)
    pico.output.clear()
    do {
        ;; a sub-layer cannot leave the block of its source
        pin src = pico.layer.empty [ dim=['!',w=8,h=8] ]
        fails("invalid escape : native pinned at", \{
            set t.sub = pico.layer.sub [ sup=src, crop=['!',x=0,y=0,w=4,h=4,anchor='NW'] ]
        })
    }
}

print("6. sprite sheet: the image lives while a sub-layer does")
do {
    pin t = [
        imgs = pico.layer.images [ path="../c/res/open.png", sheet=['#', w=2, h=2] ],
    ]
    assert(#t.imgs == 4)
    val one = t.imgs@3
    set t.imgs = nil
    pico.output.clear()
    pico.output.draw.layer(one, HALF)
    assert(shot("6-one") != empty)
    pico.output.clear()

    pin named = pico.layer.images [ path="../c/res/open.png",
        sheet=['!', a=['!',x=0,y=0,w=10,h=10,anchor='NW'],
                    b=['!',x=10,y=10,w=20,h=20,anchor='NW']] ]
    assert(type(named.a)=='native' && type(named.b)=='native' && #named==0)
    val old = pico.set.layer(named.b)
    assert(pico.get.scene().dim.w == 20)
    pico.set.layer(old)

    ;; the sub-layers of a sheet belong to the block of their parent
    do {
        pin parent = pico.layer.empty [ dim=['!',w=20,h=20] ]
        pin subs = pico.layer.images [ up=parent, path="../c/res/open.png", sheet=['#', w=2, h=2] ]
        assert(#subs == 4)
        fails("invalid escape : native pinned at", \{ set t.sub = subs@0 })
    }
}

print("7. fonts and sounds")
do {
    val TXT = ['!', x=10, y=10, h=10, anchor='NW']
    pico.output.draw.text("abc", TXT)
    val builtin = shot("7-builtin")
    assert(builtin != empty)
    pico.output.clear()
    pin dv = pico.font.load("../c/res/DejaVuSans.ttf")
    pico.set.pencil [ font=dv ]
    pico.output.draw.text("abc", TXT)
    val dejavu = shot("7-dejavu")
    assert(dejavu!=empty && dejavu!=builtin)
    pico.set.pencil [ font=true ]
    pico.output.clear()

    do {
        pin f = pico.font.load("../c/res/DejaVuSans.ttf")
        pico.set.pencil [ font=f ]          ;; a pinned value in a table, with no pin
        assert(pico.get.pencil().font == f)
    }                               ;; released: the pencil goes back to the built-in font
    assert(pico.get.pencil().font == nil)
    pico.output.draw.text("abc", TXT)
    assert(shot("7-text") == builtin)
    pico.output.clear()

    ;; the font of the pencils of two layers, the current one and another
    do {
        pin l = pico.layer.empty [ up=world, dim=['!',w=40,h=20], target=HALF ]
        do {
            pin f = pico.font.load("../c/res/DejaVuSans.ttf")
            pico.set.pencil [ font=f ]
            val old = pico.set.layer(l)
            pico.set.pencil [ font=f ]
            pico.set.layer(old)
        }
        assert(pico.get.pencil().font == nil)
        pico.output.draw.text("abc", TXT)
        pico.set.layer(l)
        assert(pico.get.pencil().font == nil)
        pico.output.draw.text("abc", ['!', x=0, y=0, h=10, anchor='NW'])
        pico.set.layer(world)
        val two = shot("7-two")
        pico.output.clear()
        pico.set.layer(l)
        pico.output.clear()
        pico.set.pencil [ font=true ]
        pico.output.draw.text("abc", ['!', x=0, y=0, h=10, anchor='NW'])
        pico.set.layer(world)
        pico.set.pencil [ font=true ]
        pico.output.draw.text("abc", TXT)
        assert(shot("7-two-true") == two)
        pico.output.clear()
    }

    ;; a current layer and the font of its pencil, in the same block, in
    ;; both orders: the font goes first, or the layer
    do {
        pin l = pico.layer.empty [ dim=['!',w=40,h=20] ]
        pin f = pico.font.load("../c/res/DejaVuSans.ttf")
        pico.set.layer(l)
        pico.set.pencil [ font=f ]
    }
    assert(pico.get.layer() == world)
    assert(pico.get.pencil().font == nil)
    do {
        pin f = pico.font.load("../c/res/DejaVuSans.ttf")
        pin l = pico.layer.empty [ dim=['!',w=40,h=20] ]
        pico.set.layer(l)
        pico.set.pencil [ font=f ]
    }
    assert(pico.get.layer() == world)
    assert(pico.get.pencil().font == nil)

    ;; the font of a layer that is dropped goes with it
    do {
        pin l = pico.layer.empty [ dim=['!',w=40,h=20] ]
        val old = pico.set.layer(l)
        pico.set.pencil [ font=pico.font.load("../c/res/DejaVuSans.ttf") ]
        pico.output.draw.text("abc", ['!', x=0, y=0, h=10, anchor='NW'])
        pico.set.layer(old)
    }

    pin s = pico.sound.load("../c/res/start.wav")
    pico.output.sound(s)
    pico.output.sound("../c/res/start.wav")
    do {
        pin p = pico.sound.load("../c/res/start.wav")
        pico.output.sound(p)
    }                               ;; released with its block
    fails("expected sound", \{ pico.output.sound(world) })
    fails("expected layer", \{ pico.set.layer(pico.font.load("../c/res/tiny.ttf")) })
}

print("8. wrong arguments")
;; no explicit free: the end of the block that owns the value
assert(pico.layer.free==nil && pico.font.free==nil && pico.sound.free==nil)
fails("expected layer",        \{ pico.set.layer(nil) })
fails("expected layer",        \{ pico.set.layer("world") })
fails("expected rect table",   \{ pico.output.draw.rect(10) })
fails("invalid mode at index 0", \{ pico.output.draw.rect([x=1, y=1]) })
fails("invalid mode '?'",      \{ pico.output.draw.rect(['?', x=1, y=1]) })
fails("expected numeric field 'x'", \{ pico.output.draw.rect(['!', y=1]) })
fails("invalid anchor \"X\"",  \{ pico.output.draw.rect(['!', x=1, y=1, anchor='X']) })
fails("invalid color \"xxx\"", \{ pico.set.pencil [ color='xxx' ] })
fails("invalid style",         \{ pico.set.pencil [ style='xxx' ] })
fails("invalid flip",          \{ pico.set.effect [ flip='xxx' ] })
fails("invalid event",         \{ pico.input.event('xxx') })
fails("'dim' required",        \{ pico.layer.empty [] })
fails("unexpected 'clear'",    \{ pico.layer.empty [ clear=true, dim=['!',w=1,h=1] ] })
fails("required 'path'",       \{ pico.layer.image [] })
fails("cannot open file",      \{ pico.layer.image [ path="no-such.png" ] })
fails("required 'text'",       \{ pico.layer.text [ dim=['!',h=10] ] })
fails("expected row tables",   \{ pico.layer.pixmap [ pixels=[1,2] ] })
fails("cannot host children",  \{
    pin img = pico.layer.image [ path="../c/res/open.png" ]
    pico.layer.empty [ up=img, dim=['!',w=1,h=1] ]
})
assert(redraw("8-none") == empty)

print("9. use after pico.close")
pin kept  = pico.layer.empty [ up=world, dim=['!',w=8,h=8] ]
pin kfont = pico.font.load("../c/res/DejaVuSans.ttf")
pin ksnd  = pico.sound.load("../c/res/start.wav")
pin ksub  = pico.layer.sub [ sup=kept, crop=['!',x=0,y=0,w=4,h=4,anchor='NW'] ]
pico.set.layer(kept)
pico.close()
fails("pico is not open", \{ pico.set.layer(kept) })
fails("pico is not open", \{ pico.output.draw.layer(kept) })
fails("pico is not open", \{ pico.get.layer() })

print("10. open again: the values from before are invalid")
pico.open [ title="Life", show=true ]
assert(pico.get.app().title == "Life")
fails("invalid layer", \{ pico.set.layer(kept) })
fails("invalid layer", \{ pico.set.layer(world) })
fails("invalid layer", \{ pico.output.draw.layer(ksub) })
fails("invalid layer", \{ pico.layer.empty [ up=kept, dim=['!',w=1,h=1] ] })
fails("invalid font",  \{ pico.set.pencil [ font=kfont ] })
fails("invalid sound", \{ pico.output.sound(ksnd) })
set world = pico.layer.world
assert(pico.get.layer() == world)
pico.output.clear()
assert(shot("10-empty") == empty)

print("11. termination with values alive and pico open")
pin last1 = pico.layer.empty [ up=world, dim=['!',w=8,h=8] ]
pin last2 = pico.layer.empty [ up=last1, dim=['!',w=2,h=2] ]
pin last3 = pico.layer.sub [ sup=last1, crop=['!',x=0,y=0,w=4,h=4,anchor='NW'] ]
pin last4 = pico.font.load("../c/res/DejaVuSans.ttf")
pico.set.layer(last2)
pico.set.pencil [ font=last4 ]
print("ok")
