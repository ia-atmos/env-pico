pico.open()
pico.set.app [ title="Expert FPS" ]

;; test 1: returns ms
val ms = pico.set.expert(true, 40)
assert(ms == 25)

;; test 2: fps=0 returns -1 (block forever)
val ms0 = pico.set.expert(true, 0)
assert(ms0 == -1)

;; test 3: frame timing
pico.set.expert(true, 40)
val t0 = pico.get.now()
loop i in (1, 4) {
    pico.input.event()
}
val elapsed = pico.get.now() - t0
assert(elapsed>=100 && elapsed<=150)  ;; slack for valgrind on CI

;; test 4: backward compat (no fps arg)
val ms1 = pico.set.expert(true)
assert(ms1 == -1)

;; test 5: fps=true (as fast as possible) returns ms=0
val ms2 = pico.set.expert(true, true)
assert(ms2 == 0)

;; test 6: fps=false returns ms=-1
val ms3 = pico.set.expert(true, false)
assert(ms3 == -1)

;; test 7: fps=true returns immediately, evt=nil
pico.set.expert(true, true)
val e1, dt1 = pico.input.event()
assert(e1 == nil)
assert(dt1 <= 15)

;; test 8: with fps=40, the event comes at the deadline of the frame, 25ms
;; after the clock of frames was set (dt2 is only what was left to wait)
val t8 = pico.get.now()
pico.set.expert(true, 40)
val e2, dt2 = pico.input.event()
val t9 = pico.get.now()
assert(e2 == nil)
assert(t9-t8>=25 && t9-t8<=40)
assert(dt2>=0 && dt2<=40)

pico.close()
