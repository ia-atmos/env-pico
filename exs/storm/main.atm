val W = 640
val H = 480

pico.open()
pico.set.app [ title="Storm" ]
pico.set.dim ['!', w=W, h=H]
pico.set.effect [ color=[ r=0x21, g=0x2C, b=0x34 ] ]

math.randomseed(os.time())

;; Shared game state accessible by all entities.
;; The table owns the pools, which are created in it.
pin G = [
    W  = W,
    H  = H,
    PI = math.pi,
    drops  = tasks(),
    clouds = tasks(),
    booms  = tasks(),
    lights = tasks(),
]

include "ts.atm"

set G.car = spawn Car(G)

spawn Clouds(G)
spawn Collisions(G)

;; DEBUG: press Down to spawn lightning
spawn {
    loop {
        await :key.dn [key='Down']
        spawn @(G.lights) Light(
            G, [ x=300, y=0 ], 270, 50, false
        )
    }
}

await false
